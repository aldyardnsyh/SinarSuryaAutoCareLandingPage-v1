---
// src/layouts/BaseLayout.astro — <head>, SEO meta, JSON-LD, font loading
import '@fontsource/barlow-condensed/400.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../styles/tokens.css';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Path halaman, mis. '/layanan'. Kosong berarti homepage. */
  path?: string;
  /** Judul/deskripsi untuk OG & Twitter; default mengikuti title/description. */
  ogTitle?: string;
  ogDescription?: string;
}

const {
  title,
  description,
  path = '',
  ogTitle = title,
  ogDescription = description,
} = Astro.props;
// Semua URL resmi memakai www (non-www di-redirect Vercel ke www).
const canonical = `${SITE.domain}${path || '/'}`;
const ogImage = `${SITE.domain}/og-image.jpg`;

// Structured data: AutoRepair
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  '@id': `${SITE.domain}/#business`,
  name: SITE.name,
  description:
    'Bengkel mobil dan cuci hidrolik di Jl. Cijagra No. 8, Bojongsoang, Kab. Bandung. Menangani servis rutin, perbaikan, sampai cuci kolong dengan lift hidrolik dan steam wash interior.',
  url: `${SITE.domain}/`,
  telephone: '+62' + SITE.whatsapp.slice(2),
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: SITE.phoneIntl,
      contactType: 'customer service',
      areaServed: 'ID',
      availableLanguage: ['id'],
    },
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: 'Bojongsoang',
    addressRegion: 'Jawa Barat',
    postalCode: SITE.address.postalCode,
    addressCountry: 'ID',
  },
  geo: { '@type': 'GeoCoordinates', latitude: SITE.geo.lat, longitude: SITE.geo.lng },
  // Panduan logo Google: raster minimal 112x112px, bukan SVG.
  logo: `${SITE.domain}/icon-512.png`,
  image: [ogImage, `${SITE.domain}/icon-512.png`],
  hasMap: SITE.gmapsShare,
  areaServed: ['Bojongsoang', 'Dayeuhkolot', 'Baleendah', 'Buahbatu', 'Bandung Selatan', 'Kabupaten Bandung'],
  openingHoursSpecification: [
    {
      // Servis & perbaikan: Senin sampai Sabtu saja (Minggu tutup)
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '07:00',
      closes: '17:00',
    },
    {
      // Cuci hidrolik: buka setiap hari, jam Minggu berbeda
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Sunday'],
      opens: '08:00',
      closes: '14:00',
    },
  ],
  priceRange: '$$',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.7',
    reviewCount: SITE.rating.count,
    bestRating: '5',
    worstRating: '1',
  },
  sameAs: [
    SITE.social.facebook,
    SITE.social.instagram,
    SITE.gmapsShare,
    ...SITE.relatedSites.map((s) => s.url),
  ].filter(Boolean),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Layanan Sinar Surya Auto Care',
    itemListElement: [
      'Servis Rutin & Tune Up',
      'Ganti Oli & Filter',
      'Service AC Mobil',
      'Kaki-kaki & Rem',
      'Kelistrikan & Aki',
      'Cuci Mobil Hidrolik',
      'Steam Wash Interior',
      'Vacuum & Detailing',
    ].map((nama) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: nama },
    })),
  },
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / WhatsApp share -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sinar Surya Auto Care, bengkel mobil dan cuci hidrolik di Bojongsoang" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#1E2228" />

    <!-- Metadata lokasi (local SEO) -->
    <meta name="geo.region" content="ID-JB" />
    <meta name="geo.placename" content="Bojongsoang, Kabupaten Bandung" />
    <meta name="geo.position" content={`${SITE.geo.lat};${SITE.geo.lng}`} />
    <meta name="ICBM" content={`${SITE.geo.lat}, ${SITE.geo.lng}`} />

    <!-- Ikon: ICO sebagai fallback yang dicari crawler (Google/Bing),
         SVG + PNG untuk browser modern, PNG 180px untuk iOS home screen. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Material Symbols (ikon saja, satu font ringan) -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=block"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
