---
// Halaman 404: Vercel otomatis menyajikan /404.html untuk URL yang tidak ada.
import BaseLayout from '../layouts/BaseLayout.astro';
import TopInfoBar from '../components/TopInfoBar.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<BaseLayout
  title="Halaman Tidak Ditemukan | Sinar Surya Auto Care"
  description="Halaman yang Anda cari tidak ditemukan. Kembali ke beranda Sinar Surya Auto Care, bengkel mobil dan cuci hidrolik di Bojongsoang, Kab. Bandung."
  ogTitle="Halaman Tidak Ditemukan | Sinar Surya Auto Care"
>
  <TopInfoBar />
  <Navbar />

  <main>
    <section class="hero-404">
      <div class="container">
        <span class="kode" aria-hidden="true">404</span>
        <h1 class="headline-lg">Halaman Ini Tidak Ditemukan</h1>
        <span class="accent-bar" aria-hidden="true"></span>
        <p class="pesan">
          Alamatnya mungkin salah ketik atau halamannya sudah dipindah. Tenang, mobil Anda
          tetap bisa kami layani. Mulai dari beranda, atau lihat langsung daftar layanannya.
        </p>
        <div class="aksi">
          <a class="btn btn-primary" href="/">Kembali ke Beranda</a>
          <a class="btn btn-white" href="/layanan">Lihat Layanan</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
</BaseLayout>

<style>
  .hero-404 {
    padding-block: 96px 112px;
    background: var(--color-dark);
    color: #edf1f9;
    text-align: center;
  }
  .kode {
    font-family: var(--font-heading);
    font-size: clamp(72px, 12vw, 120px);
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent);
    display: block;
  }
  .hero-404 .headline-lg {
    color: #fff;
    margin-top: 8px;
  }
  .hero-404 .accent-bar {
    margin-inline: auto;
    margin-block: 14px 18px;
  }
  .pesan {
    max-width: 560px;
    margin: 0 auto;
    color: #c3c6ce;
    line-height: 1.7;
  }
  .aksi {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }
</style>
