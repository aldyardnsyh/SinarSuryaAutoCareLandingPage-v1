---
// Halaman Ulasan: kutipan ulasan Google Maps asli + rating agregat.
// Schema: AutoRepair (ref @id bisnis) dengan AggregateRating + Review,
// dan BreadcrumbList. Angka mengikuti data Maps di src/data/testimoni.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import TopInfoBar from '../components/TopInfoBar.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { SITE, waLink } from '../data/site';
import { TESTIMONI } from '../data/testimoni';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${SITE.domain}/ulasan#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: `${SITE.domain}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Ulasan',
      item: `${SITE.domain}/ulasan`,
    },
  ],
};

const ulasanJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  '@id': `${SITE.domain}/#business`,
  name: SITE.name,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.7',
    reviewCount: SITE.rating.count,
    bestRating: '5',
    worstRating: '1',
  },
  review: TESTIMONI.map((t) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: t.nama },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: String(t.rating),
      bestRating: '5',
      worstRating: '1',
    },
    reviewBody: t.quote,
  })),
};
---

<BaseLayout
  title="Sinar Surya Auto Care | Ulasan Pelanggan di Google Maps"
  description="Rating 4,7 dari 96 ulasan pelanggan di Google Maps untuk Sinar Surya Auto Care Bojongsoang. Baca kutipan ulasannya, lalu lihat profil lengkap di Google."
  path="/ulasan"
  ogTitle="Ulasan Pelanggan Sinar Surya Auto Care | 4,7 dari 96 ulasan Google"
>
  <TopInfoBar />
  <Navbar />

  <main>
    <section class="page-hero">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Beranda</a>
          <span class="crumb-sep" aria-hidden="true">/</span>
          <span aria-current="page">Ulasan</span>
        </nav>
        <span class="eyebrow">Ulasan</span>
        <h1 class="headline-lg">Apa Kata Pelanggan di Google Maps</h1>
        <span class="accent-bar" aria-hidden="true"></span>
        <p class="intro">
          Rating dan kutipan di bawah diambil dari profil Google Maps Sinar Surya Auto
          Care, bukan testimoni yang kami tulis sendiri. Angkanya berlaku per akhir Oktober
          2026 dan terus bertambah seiring ulasan baru.
        </p>
      </div>
    </section>

    <section class="blok">
      <div class="container">
        <div class="ringkasan">
          <div class="ringkasan-kiri">
            <span class="skor">{SITE.rating.score}</span>
            <span class="stars" role="img" aria-label={`Rating rata-rata ${SITE.rating.score} dari 5`}>
              {
                Array.from({ length: 5 }).map(() => (
                  <span class="material-symbols-outlined star" aria-hidden="true">
                    star
                  </span>
                ))
              }
            </span>
            <p class="sumber">
              {SITE.rating.count} ulasan di Google Maps ·
              <a href={SITE.gmapsShare} target="_blank" rel="noopener">
                buka profil lengkapnya
                <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
              </a>
            </p>
          </div>
          <p class="ringkasan-kanan">
            Dari ulasan yang tampil, hal yang paling sering disebut adalah hasil cuci yang
            bersih dan sikap petugas yang ramah. Fasilitas seperti mushola, toilet, dan
            pembayaran QRIS juga sering jadi pujian, begitu pula kedai makan di sekitar
            bengkel yang menemani waktu tunggu.
          </p>
        </div>

        <div class="cards">
          {
            TESTIMONI.map((t) => (
              <article class="card">
                <span
                  class="stars"
                  role="img"
                  aria-label={`Rating ${t.rating} dari 5 bintang`}
                >
                  {Array.from({ length: 5 }).map((_, i) => (
                    <span
                      class:list={['material-symbols-outlined', 'star', { 'star-off': i >= t.rating }]}
                      aria-hidden="true"
                    >
                      star
                    </span>
                  ))}
                </span>
                <blockquote>“{t.quote}”</blockquote>
                <figcaption>
                  <span class="avatar" aria-hidden="true">{t.nama.charAt(0)}</span>
                  <span class="who">
                    <span class="nama">{t.nama}</span>
                    <span class="ket">Ulasan Google Maps</span>
                  </span>
                </figcaption>
              </article>
            ))
          }
        </div>

        <div class="tulis-ulasan">
          <h2 class="headline-lg">Sudah Pernah Mencoba Layanan Kami?</h2>
          <p>
            Ceritakan pengalaman Anda di Google Maps. Ulasan jujur, termasuk yang kritis,
            jauh lebih berguna bagi pemilik mobil lain daripada rating kosong.
          </p>
          <div class="cta-actions">
            <a class="btn-primary btn" href={SITE.gmapsShare} target="_blank" rel="noopener">
              <span class="material-symbols-outlined" aria-hidden="true">rate_review</span>
              Tulis Ulasan di Google Maps
            </a>
            <a class="btn-wa btn" href={waLink()} target="_blank" rel="noopener">
              Chat WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(ulasanJsonLd)} />
</BaseLayout>

<style>
  .page-hero {
    padding-block: 56px 64px;
    background: var(--color-dark);
    color: #edf1f9;
  }
  .page-hero .headline-lg {
    color: #fff;
    max-width: 720px;
  }
  .page-hero .accent-bar {
    margin-block: 14px 18px;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #9aa1ad;
    margin-bottom: 20px;
  }
  .crumbs a {
    color: #ffddb4;
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .crumb-sep {
    color: #6b7280;
  }
  .intro {
    max-width: 640px;
    color: #c3c6ce;
    line-height: 1.7;
    margin: 0;
  }
  .blok {
    padding-block: var(--section-py);
    background: var(--color-bg-light);
  }
  .ringkasan {
    background: var(--color-dark);
    color: #edf1f9;
    border-radius: var(--radius-card);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 36px;
  }
  .skor {
    font-family: var(--font-heading);
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
    color: #fff;
  }
  .stars {
    display: inline-flex;
    gap: 2px;
    color: var(--color-accent);
  }
  .star {
    font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24;
    font-size: 22px;
  }
  .star-off {
    color: #d8dce3;
  }
  .sumber {
    margin: 10px 0 0;
    font-size: 15px;
    color: #c3c6ce;
  }
  .sumber a {
    color: #ffddb4;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
  .sumber a:hover {
    text-decoration: underline;
  }
  .sumber .material-symbols-outlined {
    font-size: 15px;
  }
  .ringkasan-kanan {
    margin: 0;
    line-height: 1.8;
    color: #c3c6ce;
    border-top: 1px solid rgba(237, 241, 249, 0.16);
    padding-top: 20px;
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-1);
    padding: 26px 24px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  blockquote {
    margin: 0;
    line-height: 1.7;
    flex: 1;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #e4e8f0;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .who {
    display: flex;
    flex-direction: column;
  }
  .nama {
    font-weight: 700;
    color: var(--color-dark);
  }
  .ket {
    font-size: 13px;
    color: var(--color-muted);
  }
  .tulis-ulasan {
    margin-top: 48px;
    padding-top: 36px;
    border-top: 1px solid #e2e6ee;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
  }
  .tulis-ulasan p {
    margin: 0;
    max-width: 560px;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.7;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }
  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
    .ringkasan {
      flex-direction: row;
      align-items: center;
      gap: 32px;
    }
    .ringkasan-kiri {
      flex-shrink: 0;
      width: 240px;
    }
    .ringkasan-kanan {
      border-top: 0;
      border-left: 1px solid rgba(237, 241, 249, 0.16);
      padding-top: 0;
      padding-left: 32px;
    }
  }
</style>
