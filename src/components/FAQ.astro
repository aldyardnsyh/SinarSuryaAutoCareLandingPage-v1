---
// FAQ: pertanyaan seputar brand dan kepercayaan. Jawaban hanya memakai data
// terverifikasi: rating & ulasan Google Maps, jam buka, dan alur booking.
import { SITE } from '../data/site';

const FAQ = [
  {
    q: 'Apa itu Sinar Surya Auto Care dan layanan utamanya?',
    a: `Sinar Surya Auto Care adalah bengkel mobil yang sekaligus melayani cuci hidrolik, di ${SITE.address.street}, Bojongsoang, Kab. Bandung. Ada dua sisi pekerjaan di sini. Sisi mekanikal: servis rutin dan tune up, ganti oli dan filter, service AC mobil, kaki-kaki dan rem, sampai kelistrikan dan aki. Sisi perawatan tampilan: cuci mobil dengan lift hidrolik sampai bagian kolong, steam wash interior, lalu vacuum dan detailing. Satu kendaraan bisa ditangani dari mesin sampai kabin di lokasi yang sama.`,
  },
  {
    q: 'Apakah Sinar Surya Auto Care bengkel yang tepercaya?',
    a: `Silakan cek dulu sebelum datang, itu wajar. Profil kami di Google Maps memuat ${SITE.rating.count} ulasan pelanggan dengan rating rata-rata ${SITE.rating.score} dari 5. Yang sering dipuji adalah hasil cuci yang bersih dan keramahan petugasnya. Kalau masih ragu, baca ulasannya satu per satu, atau mulai dari urusan ringan seperti cuci mobil supaya Anda bisa menilai sendiri cara kerja kami.`,
  },
  {
    q: 'Apa keunggulan Sinar Surya Auto Care dibanding bengkel lain?',
    a: 'Beberapa hal yang biasanya membuat pelanggan betah. Estimasi dikerjakan lewat WhatsApp sebelum Anda datang, jadi tidak ada kejutan biaya di tengah jalan. Untuk urusan kebersihan, ada lift hidrolik khusus cuci: bagian bawah mobil ikut dibersihkan, bukan hanya badan dan velg. Fasilitasnya juga mendukung: tersedia mushola dan toilet, pembayaran bisa pakai QRIS, dan kalau harus menunggu ada kedai makan di sekitar lokasi. Cuci hidrolik buka setiap hari, termasuk Minggu.',
  },
  {
    q: 'Apakah ada garansi pengerjaan?',
    a: 'Ketentuannya mengikuti jenis pekerjaan dan kondisi mobil Anda, jadi paling tepat ditanyakan langsung saat konsultasi. Ceritakan keluhannya lewat WhatsApp, tim kami akan menjelaskan cakupan perbaikan dan ketentuan yang menyertainya sebelum pengerjaan disetujui. Untuk cuci dan detailing, hasilnya bisa langsung Anda periksa sebelum mobil keluar dari lokasi.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="faq" aria-labelledby="faq-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Tanya Jawab</span>
      <h2 class="headline-lg" id="faq-title">Pertanyaan yang Sering Diajukan</h2>
      <span class="accent-bar" aria-hidden="true"></span>
    </div>

    <div class="faq-list">
      {
        FAQ.map((f, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>
              <span class="faq-q">{f.q}</span>
              <span class="material-symbols-outlined faq-icon" aria-hidden="true">
                expand_more
              </span>
            </summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>

<style>
  .faq {
    padding-block: var(--section-py);
    background: var(--color-card);
  }
  .section-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 40px;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 880px;
  }
  .faq-item {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-1);
    overflow: hidden;
  }
  .faq-item[open] {
    border-color: #f0d8a8;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 20px;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--color-dark);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq-q {
    font-size: 15px;
  }
  .faq-icon {
    font-size: 22px;
    color: var(--color-accent);
    transition: transform 0.2s;
    flex-shrink: 0;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }
  .faq-a {
    margin: 0;
    padding: 0 20px 18px;
    line-height: 1.7;
    color: var(--color-text);
  }
</style>
