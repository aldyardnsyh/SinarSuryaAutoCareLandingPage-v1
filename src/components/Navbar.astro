---
// Sticky navbar: logo, menu anchor, CTA WhatsApp + Booking. Hamburger di mobile.
// Anchor memakai root-relative (`/#tentang`) agar tetap berfungsi saat dipakai
// di halaman selain homepage.
import { SITE, waLink } from '../data/site';

const base = Astro.url.pathname === '/' ? '' : '/';
const menu = [
  { label: 'Beranda', href: `${base}#beranda` },
  { label: 'Tentang', href: `${base}#tentang` },
  { label: 'Layanan', href: `${base}#layanan` },
  { label: 'Kontak', href: `${base}#kontak` },
];
---

<header class="navbar">
  <div class="container navbar-inner">
    <a class="brand" href={`${base}#beranda`} aria-label="Sinar Surya Auto Care, kembali ke atas">
      <span class="brand-mark material-symbols-outlined" aria-hidden="true">wb_sunny</span>
      <span class="brand-text">
        <span class="brand-name">SSAC · Sinar Surya Auto Care</span>
        <span class="brand-sub">Bengkel Mobil &amp; Cuci Hidrolik</span>
      </span>
    </a>

    <nav class="menu" aria-label="Navigasi utama">
      {menu.map((m) => <a href={m.href}>{m.label}</a>)}
    </nav>

    <div class="actions">
      <a
        class="btn-wa btn nav-wa"
        href={waLink()}
        target="_blank"
        rel="noopener"
        aria-label={`Chat WhatsApp ${SITE.name} di ${SITE.whatsappDisplay}`}
      >
        <svg class="wa-glyph" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
          ></path>
        </svg>
        <span>{SITE.whatsappDisplay}</span>
      </a>
      <a class="btn-primary btn nav-booking" href={`${base}#kontak`}>
        <span class="material-symbols-outlined" aria-hidden="true">build</span>
        <span>Booking Service</span>
      </a>
      <button
        class="hamburger"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Buka menu navigasi"
      >
        <span class="material-symbols-outlined" data-icon="menu">menu</span>
      </button>
    </div>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Navigasi mobile" hidden>
    {menu.map((m) => <a href={m.href}>{m.label}</a>)}
    <a href={`${base}#kontak`}>Booking Service</a>
    <a class="btn-wa btn" href={waLink()} target="_blank" rel="noopener">Chat WhatsApp</a>
  </nav>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.06);
  }
  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 72px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .brand-mark {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--color-primary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    flex-shrink: 0;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .brand-name {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-primary);
    white-space: nowrap;
  }
  .brand-sub {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }
  .menu {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .menu a {
    text-decoration: none;
    color: var(--color-text);
    font-weight: 500;
    transition: color 0.15s;
  }
  .menu a:hover {
    color: var(--color-primary);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nav-wa {
    padding: 8px 14px;
    font-size: 13px;
    border-radius: 10px;
  }
  .wa-glyph {
    width: 16px;
    height: 16px;
  }
  .nav-booking {
    padding: 9px 16px;
    font-size: 15px;
    border-radius: 10px;
  }
  .hamburger {
    display: none;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: #fff;
    cursor: pointer;
    color: var(--color-dark);
    align-items: center;
    justify-content: center;
  }
  .mobile-menu {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 8px var(--gutter-mobile) 16px;
    border-top: 1px solid var(--color-border);
    background: #fff;
  }
  .mobile-menu a {
    padding: 12px 8px;
    text-decoration: none;
    color: var(--color-dark);
    font-weight: 600;
    border-radius: 8px;
  }
  .mobile-menu a:hover {
    background: var(--color-bg-light);
    color: var(--color-primary);
  }
  .mobile-menu .btn {
    margin-top: 8px;
  }

  @media (max-width: 1023px) {
    .menu {
      display: none;
    }
    .hamburger {
      display: inline-flex;
    }
    .navbar.menu-open .mobile-menu {
      display: flex;
    }
  }
  @media (max-width: 639px) {
    .nav-booking {
      display: none;
    }
    .nav-wa span:last-child {
      display: none;
    }
    .nav-wa {
      padding: 9px 12px;
    }
  }
  @media (max-width: 479px) {
    .brand-mark {
      width: 34px;
      height: 34px;
      font-size: 20px;
    }
    .brand-name {
      font-size: 16px;
      white-space: normal;
    }
    .brand-sub {
      font-size: 11px;
    }
    .hamburger {
      width: 36px;
      height: 36px;
    }
    .navbar-inner {
      gap: 8px;
    }
  }
</style>

<script>
  // Toggle menu mobile (vanilla, ringan)
  const navbar = document.querySelector<HTMLElement>('.navbar');
  const toggle = navbar?.querySelector<HTMLButtonElement>('.hamburger');
  const icon = toggle?.querySelector<HTMLElement>('.material-symbols-outlined');
  toggle?.addEventListener('click', () => {
    const open = navbar!.classList.toggle('menu-open');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');
    if (icon) icon.textContent = open ? 'close' : 'menu';
  });
  // Tutup menu setelah pilih anchor
  navbar?.querySelectorAll('.mobile-menu a').forEach((a) =>
    a.addEventListener('click', () => {
      navbar.classList.remove('menu-open');
      toggle?.setAttribute('aria-expanded', 'false');
      if (icon) icon.textContent = 'menu';
    })
  );
</script>
