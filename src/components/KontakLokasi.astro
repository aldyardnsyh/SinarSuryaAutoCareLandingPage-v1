---
// Kontak & Lokasi (gelap): kartu kontak putih + embed Google Maps resmi (lazy-load).
// Embed & koordinat dari listing resmi: https://maps.app.goo.gl/q5tPToCPzbebyi2z8
import { SITE, waLink } from '../data/site';
---

<section class="kontak" id="kontak">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Lokasi &amp; Kontak</span>
      <h2 class="headline-lg">Kunjungi Bengkel Kami di Bojongsoang</h2>
      <span class="accent-bar" aria-hidden="true"></span>
    </div>

    <div class="grid">
      <div class="card-kontak">
        <div>
          <span class="eyebrow kontak-eyebrow">SSAC Bojongsoang</span>
          <h3>Sinar Surya Auto Care</h3>
        </div>

        <ul class="info">
          <li>
            <span class="material-symbols-outlined ic-red" aria-hidden="true">location_on</span>
            <p>
              {SITE.address.street}, {SITE.address.detail} {SITE.address.postalCode}
            </p>
          </li>
          <li>
            <span class="material-symbols-outlined ic-red" aria-hidden="true">call</span>
            <a href={`tel:${SITE.phoneIntl}`} class="strong">{SITE.phoneDisplay}</a>
          </li>
          <li>
            <span class="material-symbols-outlined ic-wa" aria-hidden="true">chat</span>
            <a
              href={waLink('Mau tanya-tanya dulu soal layanan bengkelnya.')}
              target="_blank"
              rel="noopener"
              class="strong">WhatsApp {SITE.whatsappDisplay}</a
            >
          </li>
          <li>
            <span class="material-symbols-outlined ic-amber" aria-hidden="true">build</span>
            <p>
              <span class="strong">Servis &amp; Perbaikan:</span> Senin – Sabtu 07.00 – 17.00
              <span class="mini-chip" id="jam-chip-servis">
                <span class="mini-dot" aria-hidden="true"></span><span class="mini-text">Memuat…</span>
              </span>
            </p>
          </li>
          <li>
            <span class="material-symbols-outlined ic-amber" aria-hidden="true">local_car_wash</span>
            <p>
              <span class="strong">Cuci Hidrolik &amp; Steam:</span> Senin – Sabtu 07.00 – 17.00,
              Minggu 08.00 – 14.00
              <span class="mini-chip" id="jam-chip-cuci">
                <span class="mini-dot" aria-hidden="true"></span><span class="mini-text">Memuat…</span>
              </span>
            </p>
          </li>
          <li>
            <span class="material-symbols-outlined ic-amber" aria-hidden="true">star</span>
            <a href={SITE.gmapsShare} target="_blank" rel="noopener" class="strong">
              {SITE.rating.score} dari {SITE.rating.count} ulasan di Google
            </a>
          </li>
        </ul>

        <div class="card-actions">
          <a
            class="btn-wa btn"
              href={waLink('Saya mau tanya rute ke lokasi bengkel.')}
            target="_blank"
            rel="noopener"
          >
            Hubungi via WhatsApp
          </a>
          <a class="maps-link" href={SITE.gmapsShare} target="_blank" rel="noopener">
            Buka di Google Maps
            <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
          </a>
        </div>
      </div>

      <div class="map-wrap">
        <iframe
          title="Peta lokasi Sinar Surya Auto Care, Jl. Cijagra No. 8, Bojongsoang, Kab. Bandung"
          src={SITE.mapsEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <a class="map-overlay" href={SITE.gmapsShare} target="_blank" rel="noopener">
          <span class="map-badge">
            <span class="material-symbols-outlined" aria-hidden="true">directions_car</span>
          </span>
          <span class="map-text">
            <span class="map-name">Sinar Surya Auto Care</span>
            <span class="map-sub">Bojongsoang, Kab. Bandung</span>
          </span>
          <span class="map-route"
            >Rute <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span></span
          >
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .kontak {
    padding-block: var(--section-py);
    background: var(--color-dark);
    color: #fff;
  }
  .section-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 48px;
  }
  .section-head h2 {
    color: #fff;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: stretch;
  }
  .card-kontak {
    background: var(--color-card);
    color: var(--color-dark);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-2);
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
  }
  .kontak-eyebrow {
    color: var(--color-primary);
  }
  .card-kontak h3 {
    font-size: 24px;
    font-weight: 700;
    margin-top: 4px;
  }
  .info {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .info li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-text);
  }
  .info p {
    margin: 0;
  }
  .info a {
    color: inherit;
    text-decoration: none;
  }
  .info a:hover {
    color: var(--color-primary);
  }
  .strong {
    font-weight: 600;
  }
  .ic-red {
    color: var(--color-primary);
  }
  .ic-wa {
    color: var(--color-wa);
  }
  .ic-amber {
    color: var(--color-accent);
  }
  .info .material-symbols-outlined {
    font-size: 20px;
    flex-shrink: 0;
  }
  .card-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .maps-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    color: var(--color-primary);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }
  .maps-link .material-symbols-outlined {
    font-size: 16px;
  }
  .maps-link:hover {
    text-decoration: underline;
  }

  .map-wrap {
    position: relative;
    min-height: 380px;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-2);
  }
  .map-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .map-overlay {
    position: absolute;
    left: 16px;
    bottom: 16px;
    right: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: rgba(30, 34, 40, 0.95);
    backdrop-filter: blur(8px);
    padding: 12px 16px;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-2);
    color: #fff;
    text-decoration: none;
  }
  .map-badge {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .map-badge .material-symbols-outlined {
    font-size: 22px;
  }
  .map-text {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .map-name {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.1;
  }
  .map-sub {
    font-size: 13px;
    color: #c3c6ce;
  }
  .map-route {
    background: #fff;
    color: var(--color-dark);
    padding: 8px 14px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .map-route .material-symbols-outlined {
    font-size: 16px;
  }
  .map-route:hover {
    background: #eaeef6;
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: 5fr 7fr;
    }
  }
  .mini-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: 6px;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    background: #f0f4fb;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-dark);
    vertical-align: middle;
  }
  .mini-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #9ca3af;
  }
  .mini-chip.open .mini-dot {
    background: #1fa855;
  }
  .mini-chip.closed .mini-dot {
    background: #e0632a;
  }
</style>

<script>
  import { hitungStatus } from '../data/site';

  function perbarui(): void {
    const s = hitungStatus();
    for (const [id, buka, teks] of [
      ['jam-chip-servis', s.servisBuka, s.servisStatus],
      ['jam-chip-cuci', s.cuciBuka, s.cuciStatus],
    ] as const) {
      const el = document.getElementById(id);
      if (!el) continue;
      el.classList.toggle('open', buka);
      el.classList.toggle('closed', !buka);
      el.querySelector('.mini-text')!.textContent = buka ? 'Buka sekarang' : 'Tutup';
      el.setAttribute('title', teks);
    }
  }

  perbarui();
  setInterval(perbarui, 30000);
</script>
