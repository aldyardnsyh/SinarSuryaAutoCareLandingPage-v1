---
// Galeri: foto asli dari listing Google Maps bengkel
// (https://maps.app.goo.gl/q5tPToCPzbebyi2z8). Ganti dengan foto klien terbaru
// ([DATA-CLIENT:foto-bengkel]) saat tersedia.
// Kartu memakai tag kategori + nomor + aksen oranye agar tidak monoton.
import { Image } from 'astro:assets';
import fotoKolong from '../assets/cuci-mobil-hidrolik-kolong.jpg';
import fotoBusa from '../assets/cuci-mobil-busa.jpg';
import fotoMpv from '../assets/cuci-hidrolik-mpv.jpg';
import fotoJazz from '../assets/detailing-interior-jazz.jpg';
import fotoHasil from '../assets/hasil-detailing-sienta.jpg';
import fotoRamai from '../assets/area-cuci-ramai-pelanggan.png';
import fotoServisLift from '../assets/mekanik-servis-mobil-lift.png';
import fotoMesin from '../assets/pemeriksaan-mesin-mobil.png';
import fotoProses from '../assets/proses-servis-mobil.png';

const FOTO = [
  {
    src: fotoKolong,
    alt: 'Cuci mobil hidrolik bagian kolong di Sinar Surya Auto Care Bojongsoang, Bandung',
    caption: 'Cuci hidrolik sampai bagian kolong',
    tag: 'Cuci Hidrolik',
    position: 'attention' as const,
  },
  {
    src: fotoRamai,
    alt: 'Suasana ramai area cuci mobil Sinar Surya Auto Care dengan banyak mobil pelanggan',
    caption: 'Ramai pelanggan di area cuci',
    tag: 'Cuci Hidrolik',
    position: 'attention' as const,
  },
  {
    src: fotoServisLift,
    alt: 'Mekanik Sinar Surya Auto Care mengerjakan mobil di atas lift di area servis',
    caption: 'Mekanik mengerjakan mobil di area servis',
    tag: 'Servis',
    position: 'attention' as const,
  },
  {
    src: fotoBusa,
    alt: 'Proses cuci mobil dengan busa di bengkel Sinar Surya Auto Care',
    caption: 'Proses cuci busa menyeluruh',
    tag: 'Cuci Hidrolik',
    position: 'attention' as const,
  },
  {
    src: fotoMesin,
    alt: 'Pemeriksaan ruang mesin mobil di bengkel Sinar Surya Auto Care Bojongsoang',
    caption: 'Pemeriksaan ruang mesin',
    tag: 'Servis',
    position: 'attention' as const,
  },
  {
    src: fotoMpv,
    alt: 'MPV diangkat lift hidrolik saat dicuci di Bojongsoang, Bandung',
    caption: 'Mobil diangkat saat dicuci hidrolik',
    tag: 'Cuci Hidrolik',
    position: 'center' as const,
  },
  {
    src: fotoProses,
    alt: 'Proses servis mobil dengan kap terbuka di Sinar Surya Auto Care',
    caption: 'Proses servis mobil berjalan',
    tag: 'Servis',
    position: 'center' as const,
  },
  {
    src: fotoJazz,
    alt: 'Detailing interior mobil dengan pintu terbuka di Sinar Surya Auto Care',
    caption: 'Detailing interior mobil',
    tag: 'Detailing',
    position: 'attention' as const,
  },
  {
    src: fotoHasil,
    alt: 'Hasil detailing mobil mengkilap di Sinar Surya Auto Care Bojongsoang',
    caption: 'Hasil detailing',
    tag: 'Detailing',
    position: 'center' as const,
  },
];
---

<section class="galeri">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Dokumentasi Workshop</span>
      <h2 class="headline-lg">Sekilas Bengkel Kami</h2>
      <span class="accent-bar" aria-hidden="true"></span>
    </div>

    <div class="grid">
      {
        FOTO.map((f, i) => (
          <figure class="item">
            <div class="media">
              <Image
                src={f.src}
                alt={f.alt}
                widths={[300, 560, 720]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                width={800}
                height={600}
                fit="cover"
                position={f.position}
                loading="lazy"
              />
              <span class="tag">{f.tag}</span>
            </div>
            <figcaption>
              <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="cap">{f.caption}</span>
              <span class="cap-line" aria-hidden="true"></span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .galeri {
    padding-block: var(--section-py);
    background: var(--color-card);
  }
  .section-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 48px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .item {
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: #f0f4fb;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-1);
    transition: box-shadow 0.2s, border-color 0.2s, transform 0.2s;
  }
  .item:hover {
    box-shadow: var(--shadow-2);
    border-color: var(--color-accent);
    transform: translateY(-3px);
  }
  .media {
    position: relative;
    overflow: hidden;
  }
  .item img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    transition: transform 0.35s;
  }
  .item:hover img {
    transform: scale(1.06);
  }
  .tag {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: rgba(30, 34, 40, 0.85);
    backdrop-filter: blur(4px);
    color: #ffddb4;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.3;
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: #fff;
  }
  .num {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }
  .cap {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-dark);
    flex: 1;
    line-height: 1.4;
  }
  .cap-line {
    width: 22px;
    height: 3px;
    border-radius: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s;
  }
  .item:hover .cap-line {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
