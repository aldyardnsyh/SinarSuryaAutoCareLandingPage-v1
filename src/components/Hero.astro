---
// Hero gelap dengan foto workshop + overlay, CTA, dan kartu trust strip overlap.
import { Image } from 'astro:assets';
import { SITE, waLink } from '../data/site';
import { TRUST_STRIP } from '../data/layanan';
import heroImg from '../assets/bengkel-mobil-bojongsoang-lift-hidrolik.jpg';

const waBooking = waLink('Saya mau booking jadwal servis. Hari ini masih bisa masuk jadwal?');
const waChat = waLink('Saya mau konsultasi dulu keluhan mobil saya ya.');
---

<section class="hero" id="beranda">
  <div class="hero-bg" aria-hidden="true">
    <Image
      src={heroImg}
      alt="Mobil diangkat lift hidrolik saat dicuci di Sinar Surya Auto Care Bojongsoang, Bandung"
      widths={[720, 1080, 1440]}
      sizes="100vw"
      width={1600}
      height={900}
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-scrim"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-content">
      <a
        class="hero-status"
        href="#kontak"
        id="hero-status"
        title="Klik untuk lihat detail jam operasional"
      >
        <span class="status-dot" aria-hidden="true"></span>
        <span class="status-text" id="hero-status-text"
          >Buka setiap hari 07.00 – 17.00 · Servis Senin – Sabtu</span
        >
        <span class="status-arrow material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </a>
      <h1 class="hero-title">Satu Tempat untuk Servis &amp; Cuci Mobil Anda</h1>
      <span class="accent-bar" aria-hidden="true"></span>
      <p class="hero-sub">
        Sinar Surya Auto Care melayani servis rutin, perbaikan, hingga cuci mobil hidrolik.
        Dikerjakan rapi dan sesuai jadwal.
      </p>
      <div class="hero-cta">
        <a class="btn-primary btn" href={waBooking} target="_blank" rel="noopener">
          <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
          Booking Sekarang
        </a>
        <a class="btn-outline-white btn" href={waChat} target="_blank" rel="noopener">
          <span class="material-symbols-outlined" aria-hidden="true">chat</span>
          Chat WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Kartu trust strip yang menempel overlap ke bawah hero -->
<section class="trust" aria-label="Keunggulan Sinar Surya Auto Care">
  <div class="container">
    <div class="trust-card">
      {
        TRUST_STRIP.map((p) => (
          <div class="trust-item">
            <span class="trust-icon">
              <span class="material-symbols-outlined" aria-hidden="true">{p.ikon}</span>
            </span>
            <div>
              <h3>{p.judul}</h3>
              <p>{p.deskripsi}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-dark);
    color: #fff;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.65;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(30, 34, 40, 0.82) 0%,
      rgba(30, 34, 40, 0.4) 45%,
      rgba(30, 34, 40, 0.3) 100%
    );
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    padding-block: 96px 144px;
  }
  .hero-content {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(44, 49, 55, 0.85);
    border: 1px solid rgba(237, 241, 249, 0.15);
    backdrop-filter: blur(6px);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    color: #edf1f9;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .hero-status:hover {
    border-color: var(--color-accent);
    background: rgba(44, 49, 55, 0.95);
  }
  .status-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #9ca3af;
    flex-shrink: 0;
    transition: background 0.3s, box-shadow 0.3s;
  }
  .hero-status.open .status-dot {
    background: #2ee06f;
    box-shadow: 0 0 0 3px rgba(46, 224, 111, 0.22);
  }
  .hero-status.closed .status-dot {
    background: #ff8a5c;
    box-shadow: 0 0 0 3px rgba(255, 138, 92, 0.18);
  }
  .status-text {
    font-variant-numeric: tabular-nums;
  }
  .status-arrow {
    font-size: 16px;
    color: #ffb955;
    transition: transform 0.2s;
  }
  .hero-status:hover .status-arrow {
    transform: translateX(3px);
  }
  .hero-title {
    font-size: clamp(38px, 6vw, 56px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #fff;
    margin: 0;
  }
  .hero-sub {
    font-size: 17px;
    line-height: 26px;
    color: #c3c6ce;
    max-width: 560px;
    margin: 0;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }

  .trust {
    position: relative;
    z-index: 2;
    margin-top: -80px;
    padding-bottom: 16px;
  }
  .trust-card {
    background: #fff;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-2);
    padding: 24px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .trust-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .trust-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-card);
    background: var(--color-bg-light);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .trust-item h3 {
    font-size: 19px;
    font-weight: 700;
  }
  .trust-item p {
    margin: 4px 0 0;
    font-size: 13px;
    line-height: 18px;
    color: var(--color-muted);
  }

  @media (min-width: 640px) {
    .trust-card {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .trust-card {
      grid-template-columns: repeat(4, 1fr);
    }
    .hero-inner {
      padding-block: 120px 176px;
    }
  }
</style>

<script>
  import { infoRealtimeHero } from '../data/site';

  const pill = document.getElementById('hero-status');
  const teks = document.getElementById('hero-status-text');

  function perbarui(): void {
    if (!pill || !teks) return;
    const info = infoRealtimeHero();
    teks.textContent = info.teks;
    pill.classList.toggle('open', info.buka);
    pill.classList.toggle('closed', !info.buka);
  }

  perbarui();
  setInterval(perbarui, 30000);
</script>
